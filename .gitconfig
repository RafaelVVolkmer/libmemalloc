# Activated locally by playbook.yml. Identity and keys remain user settings.
[core]
  hooksPath = .githooks
  autocrlf = false
  commentChar = "#"

[commit]
  template = .gitmessage
  cleanup = strip
  gpgSign = true

[tag]
  gpgSign = true

[gpg]
  format = openpgp

[pull]
  ff = only

[push]
  default = simple

[fetch]
  prune = true

[diff]
  algorithm = histogram
  colorMoved = zebra

[merge]
  conflictStyle = zdiff3

[rerere]
  enabled = true
  autoUpdate = false

# EOF

