{
  "version": 8,
  "$schema": "https://cmake.org/cmake/help/latest/manual/presets/schema.json",
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "vendor": {
    "libmemalloc.org/build/1.0": {
      "license": "GPL-3.0-only",
      "copyright": "2026 Rafael V. Volkmer",
      "scope": "Distribution fixture; no product qualification"
    }
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.cache/build/presets/${presetName}",
      "cacheVariables": {
        "LMA_BUILD_MOCK": true,
        "LMA_BUILD_TESTS": true,
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/.cache/install/${presetName}",
        "LMA_BUILD_METADATA": true
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "libmemalloc debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "libmemalloc release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-shared",
      "inherits": "base",
      "displayName": "libmemalloc release-shared",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": true
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "displayName": "libmemalloc relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "minsize",
      "inherits": "base",
      "displayName": "libmemalloc minsize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "displayName": "libmemalloc asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LMA_SANITIZERS": "address;undefined",
        "LMA_IPO": "OFF"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "libmemalloc coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LMA_ENABLE_COVERAGE": true,
        "LMA_IPO": "OFF"
      }
    },
    {
      "name": "gcc-analyzer",
      "inherits": "base",
      "displayName": "libmemalloc gcc-analyzer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "LMA_ENABLE_ANALYZER": true
      }
    },
    {
      "name": "clang-release",
      "inherits": "base",
      "displayName": "libmemalloc clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_LINKER_TYPE": "LLD",
        "BUILD_SHARED_LIBS": true
      }
    },
    {
      "name": "multi",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "interop",
      "inherits": "base",
      "cacheVariables": {
        "LMA_COMPATIBILITY_LANGUAGES": "c;cpp;rust",
        "LMA_BUILD_TESTS": false,
        "BUILD_SHARED_LIBS": false,
        "LMA_IPO": "OFF"
      }
    },
    {
      "name": "wasm",
      "inherits": "base",
      "cacheVariables": {
        "LMA_COMPATIBILITY_LANGUAGES": "wasm",
        "LMA_BUILD_TESTS": false,
        "BUILD_SHARED_LIBS": false,
        "LMA_IPO": "OFF",
        "LMA_HARDENING": false
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/wasm32.cmake"
    },
    {
      "name": "baremetal",
      "inherits": "base",
      "cacheVariables": {
        "LMA_COMPATIBILITY_LANGUAGES": "baremetal",
        "LMA_BUILD_TESTS": false,
        "BUILD_SHARED_LIBS": false,
        "LMA_IPO": "OFF",
        "LMA_HARDENING": false
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/baremetal-aarch64.cmake"
    }
  ],
