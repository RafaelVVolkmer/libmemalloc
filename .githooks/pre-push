--- Apply the libmemalloc pre-push policy.
-- Git invokes this adapter from the worktree root.
-- Workspace modules own the checks.

--- Preserve the Git hook exit status and argument contract.
-- @return nil: no values.
local function HOOK_main()
   local hooks = dofile("scripts/workspace/lib/hooks.lua")

   os.exit(hooks.pre_push(arg))
end

return HOOK_main()

