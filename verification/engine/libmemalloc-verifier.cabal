cabal-version: 3.0
-- SPDX-FileCopyrightText: 2026 Rafael V. Volkmer <rafael.v.volkmer@gmail.com>
-- SPDX-License-Identifier: GPL-3.0-only
name: libmemalloc-verifier
version: 0.1.0.0
synopsis: Proof-producing verification engine for libmemalloc
license: GPL-3.0-only
build-type: Simple

flag liquid
  description: Audit every library, executable and test module with Liquid Haskell
  default: True
  manual: True

library
  hs-source-dirs: src
  exposed-modules:
    LibMemAlloc.Verifier.CMachine
    LibMemAlloc.Verifier.IR
    LibMemAlloc.Verifier.Import.CN
    LibMemAlloc.Verifier.Layout
    LibMemAlloc.Verifier.Protocol
    LibMemAlloc.Verifier.Refined
  build-depends: base >=4.17 && <4.18, containers >=0.6 && <0.7
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Werror
  if flag(liquid)
    build-depends: liquidhaskell ==0.9.4.7.0
    ghc-options: -fplugin=LiquidHaskell -fplugin-opt=LiquidHaskell:--fullcheck
                 -fplugin-opt=LiquidHaskell:--check-derived
                 -fplugin-opt=LiquidHaskell:--smttimeout=5000

-- EOF

