{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "libmemalloc process manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "plan_sha256",
    "run_id",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "const": "automation-pilot"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control",
          "sha256"
        ],
        "properties": {
          "control": {
            "type": "string",
            "pattern": "^LMA-CTRL-[A-Z-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
