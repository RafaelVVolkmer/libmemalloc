{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "useGitignore": true,
  "enableGlobDot": true,
  "globRoot": "../../../..",
  "files": ["**/*.{c,h,cpp,hpp,md,markdown,mdx,rst,adoc}"],
  "ignorePaths": [
    "doxygen/vendor/**",
    ".git/**",
    "LICENSES/**",
    "**/*.lock",
    "**/*.min.*",
    "**/*.{a,aff,bin,bmp,dic,dylib,elf,exe,gif,gz,ico,jpeg,jpg,o,pdf,png,so,svg,tar,webp,woff,woff2,zip}",
  ],
  "words": [
    "AAPI",
    "AINC",
    "AINT",
    "AOBJ",
    "ASRC",
    "ASTATE",
    "BAPI",
    "BINC",
    "BINT",
    "BOBJ",
    "BSRC",
    "BSTATE",
    "CMOD",
    "fdata",
    "fdebug",
    "ffile",
    "ffunction",
    "flto",
    "fvisibility",
    "implib",
    "INLINES",
    "liba",
    "libb",
    "libbackend",
    "libconsumer",
    "libfrontend",
    "libmodule",
    "libprovider",
    "MODA",
    "MODB",
    "MODC",
    "objcopy",
    "objdump",
    "readelf",
    "readobj",
    "S3",
    "Silo",
    "soname",
    "SOVERSION",
    "stdbool",
    "stddef",
  ],
  "dictionaryDefinitions": [
    {
      "name": "libmemalloc",
      "path": "../dictionary/libmemalloc-words.txt",
      "addWords": true,
    },
  ],
  "dictionaries": ["libmemalloc"],
  "ignoreRegExpList": [
    "/\\/\\*[\\s\\S]*?\\*\\//g",
    "/\\/\\/[^\\n]*/g",
    "Urls",
    "Email",
    "Base64",
    "EscapeCharacters",
    "/\\b[0-9a-f]{7,64}\\b/gi"
  ],
  "overrides": [
    {
      "filename": "**/*.{c,h,cpp,hpp}",
      "languageId": "cpp",
    },
  ],
}

// EOF

