# Generated by scripts/toolchain/sync.lua; edit the template and central lock.

[project]
name = "libmemalloc-tooling"
version = "0.0.0"
description = "Development tools for the libmemalloc C library"
requires-python = ">=@python_min.version@,<@python_max.version@"
license = "GPL-3.0-only"
dependencies = [  ]

[dependency-groups]
automation = [ "ansible-core==@ansible_core.version@" ]
quality = [ "cmakelang==@cmakelang.version@", "lizard==@lizard.version@", "luaparser==@luaparser.version@" ]
python-lint = [ "bandit==@bandit.version@", "conan==@conan.version@", "ruff==@ruff.version@" ]
publication = [ "conan==@conan.version@", "check-jsonschema==@check_jsonschema.version@" ]

c-tools = [
  "cmake==@build_cmake.version@",
  "ninja==@build_ninja.version@",
  "clang-format==@clang_format.version@",
  "clang-tidy==@clang_tidy.version@",
  "flawfinder==@flawfinder.version@",
]
reuse = [ "reuse==@reuse.version@" ]
reuse-build = [ "poetry-core==@poetry_core.version@" ]
crypto-build = [ "maturin==@maturin.version@", "setuptools==@setuptools.version@", "cffi==@python_cffi.version@" ]
spelling = [ "codespell==@codespell.version@" ]
lint = [
  "codespell==@codespell.version@",
  "yamllint==@yamllint.version@",
  "reuse==@reuse.version@",
  "cmake==@build_cmake.version@",
  "ninja==@build_ninja.version@",
  "clang-format==@clang_format.version@",
  "clang-tidy==@clang_tidy.version@",
  "flawfinder==@flawfinder.version@",
]

[tool.uv]
package = false
default-groups = [  ]

# Constraints are projected from the central lock.
constraint-dependencies = [
  "cffi==@python_cffi.version@",
  "cryptography==@python_cryptography.version@",
  "jinja2==@python_jinja2.version@",
  "markupsafe==@python_markupsafe.version@",
  "packaging==@python_packaging.version@",
  "pycparser==@python_pycparser.version@",
  "pyyaml==@python_pyyaml.version@",
  "resolvelib==@python_resolvelib.version@",
  "pathspec==@python_pathspec.version@",
  "pygments==@python_pygments.version@",
  "six==@python_six.version@",
]

